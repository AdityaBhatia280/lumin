{
  "redirects": [
    {
      "source": "/our-work",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/our-work/:slug",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/network",
      "destination": "/impact",
      "permanent": false
    },
    {
      "source": "/chapters",
      "destination": "/impact",
      "permanent": false
    },
    {
      "source": "/youth-ambassadors",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/digital-hub",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/partners",
      "destination": "/partnerships",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(about|blog|impact|partnerships|team|contact|get-involved)",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/apply/:slug",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
